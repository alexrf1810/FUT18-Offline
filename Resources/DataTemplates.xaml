<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"

    xmlns:views="clr-namespace:FUT18Launcher.Views"
    xmlns:viewModels="clr-namespace:FUT18Launcher.ViewModels"

    xmlns:homeViews="clr-namespace:FUT18Launcher.Views.Home"
    xmlns:homeViewModels="clr-namespace:FUT18Launcher.ViewModels.Home"

    xmlns:squadViews="clr-namespace:FUT18Launcher.Views.Squad"
    xmlns:squadViewModels="clr-namespace:FUT18Launcher.ViewModels.Squad"

    xmlns:storeViews="clr-namespace:FUT18Launcher.Views.Store"
    xmlns:storeViewModels="clr-namespace:FUT18Launcher.ViewModels.Store"

    xmlns:clubViews="clr-namespace:FUT18Launcher.Views.Club"
    xmlns:clubViewModels="clr-namespace:FUT18Launcher.ViewModels.Club"

    xmlns:marketViews="clr-namespace:FUT18Launcher.Views.Market"
    xmlns:marketViewModels="clr-namespace:FUT18Launcher.ViewModels.Market"

    xmlns:sbcViews="clr-namespace:FUT18Launcher.Views.SBC"
    xmlns:sbcViewModels="clr-namespace:FUT18Launcher.ViewModels.SBC">

    <DataTemplate DataType="{x:Type viewModels:CreateClubViewModel}">
        <views:CreateClubView/>
    </DataTemplate>

    <DataTemplate DataType="{x:Type homeViewModels:HomeViewModel}">
        <homeViews:HomeView/>
    </DataTemplate>

    <DataTemplate DataType="{x:Type squadViewModels:SquadViewModel}">
        <squadViews:SquadView/>
    </DataTemplate>

    <DataTemplate DataType="{x:Type storeViewModels:StoreViewModel}">
        <storeViews:StoreView/>
    </DataTemplate>

    <DataTemplate DataType="{x:Type clubViewModels:ClubViewModel}">
        <clubViews:ClubView/>
    </DataTemplate>

    <DataTemplate DataType="{x:Type marketViewModels:MarketViewModel}">
        <marketViews:MarketView/>
    </DataTemplate>

    <DataTemplate DataType="{x:Type sbcViewModels:SbcViewModel}">
        <sbcViews:SbcView/>
    </DataTemplate>

</ResourceDictionary>
