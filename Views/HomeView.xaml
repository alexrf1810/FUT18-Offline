<UserControl x:Class="FUT18Launcher.Views.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Background="#101010">

        <StackPanel HorizontalAlignment="Center"
                    VerticalAlignment="Center">

            <TextBlock Text="{Binding ClubName}"
                       FontSize="32"
                       FontWeight="Bold"
                       Foreground="White"
                       HorizontalAlignment="Center"/>

            <TextBlock Margin="0,20,0,0"
                       Text="{Binding ManagerName}"
                       FontSize="22"
                       Foreground="White"
                       HorizontalAlignment="Center"/>

            <TextBlock Margin="0,30,0,0"
                       Text="{Binding Coins, StringFormat=Monedas: {0}}"
                       FontSize="20"
                       Foreground="Gold"
                       HorizontalAlignment="Center"/>

            <TextBlock Margin="0,10,0,0"
                       Text="{Binding Level, StringFormat=Nivel: {0}}"
                       FontSize="18"
                       Foreground="White"
                       HorizontalAlignment="Center"/>

            <TextBlock Margin="0,10,0,0"
                       Text="{Binding Experience, StringFormat=Experiencia: {0}}"
                       FontSize="18"
                       Foreground="White"
                       HorizontalAlignment="Center"/>

        </StackPanel>

    </Grid>

</UserControl>
