<UserControl x:Class="FUT18Launcher.Views.Shell.ShellView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Background="#0F1117">

        <Grid.RowDefinitions>
            <RowDefinition Height="70"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Barra superior -->
        <Border Grid.Row="0"
                Grid.ColumnSpan="2"
                Background="#1B2330">

            <DockPanel Margin="20,0">

                <TextBlock
                    Text="{Binding ClubName}"
                    Foreground="White"
                    FontSize="22"
                    FontWeight="Bold"
                    VerticalAlignment="Center"/>

                <StackPanel
                    Orientation="Horizontal"
                    HorizontalAlignment="Right">

                    <TextBlock
                        Margin="20,0"
                        Text="{Binding Coins}"
                        Foreground="Gold"
                        FontSize="18"/>

                    <TextBlock
                        Margin="20,0"
                        Text="{Binding FIFAPoints}"
                        Foreground="#00BFFF"
                        FontSize="18"/>

                </StackPanel>

            </DockPanel>

        </Border>

        <!-- Menú lateral -->

        <Border Grid.Row="1"
                Background="#181E28">

            <StackPanel Margin="20">

                <Button Content="Inicio" Height="45"/>

                <Button Content="Plantilla"
                        Margin="0,10,0,0"
                        Height="45"/>

                <Button Content="Tienda"
                        Margin="0,10,0,0"
                        Height="45"/>

                <Button Content="Club"
                        Margin="0,10,0,0"
                        Height="45"/>

                <Button Content="Mercado"
                        Margin="0,10,0,0"
                        Height="45"/>

                <Button Content="SBC"
                        Margin="0,10,0,0"
                        Height="45"/>

            </StackPanel>

        </Border>

        <!-- Contenido -->

        <Border Grid.Row="1"
                Grid.Column="1"
                Background="#10141C">

            <ContentControl
                Content="{Binding CurrentViewModel}"/>

        </Border>

    </Grid>

</UserControl>
