<UserControl x:Class="FUT18Launcher.Views.CreateClubView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Background="#101010">

        <Border Width="500"
                Padding="30"
                CornerRadius="10"
                Background="#1B1B1B"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">

            <StackPanel>

                <TextBlock Text="Crear Club"
                           FontSize="30"
                           FontWeight="Bold"
                           Foreground="White"
                           HorizontalAlignment="Center"/>

                <TextBlock Margin="0,30,0,5"
                           Text="Nombre del Club"
                           Foreground="White"/>

                <TextBox Text="{Binding ClubName, UpdateSourceTrigger=PropertyChanged}"
                         Height="32"/>

                <TextBlock Margin="0,20,0,5"
                           Text="Nombre del Entrenador"
                           Foreground="White"/>

                <TextBox Text="{Binding ManagerName, UpdateSourceTrigger=PropertyChanged}"
                         Height="32"/>

                <Button Margin="0,30,0,0"
                        Height="40"
                        Content="Crear Club"/>
            </StackPanel>

        </Border>

    </Grid>

</UserControl>
